# Database
PRIMARY_DATABASE_URL=postgresql://user:pass@primary:5432/db
REPLICA_DATABASE_URLS=["postgresql://user:pass@replica1:5432/db"]

# Set to true to run entirely against simulated in-memory database nodes
SIMULATE_DB=true

# Redis (optional: falls back to an in-memory store when unset)
REDIS_URL=redis://localhost:6379

# AI APIs
HUGGINGFACE_API_KEY=hf_xxx
GEMINI_API_KEY=AIxxx
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_MODEL=gemini-1.5-flash

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=change-me
CORS_ORIGIN=*
FROM_EMAIL=noreply@your-verified-domain.com
FROM_NAME=Pg-admin
# Provided by the linked Brevo connector and Lovable runtime:
BREVO_API_KEY=
LOVABLE_API_KEY=

# Thresholds
SLOW_QUERY_THRESHOLD_MS=100
REPLICA_LAG_THRESHOLD_MS=1000
ANOMALY_DETECTION_WINDOW=1000
HEALTH_CHECK_INTERVAL_MS=5000
RATE_LIMIT_PER_MINUTE=100

# Replay
CAPTURE_DIR=./captures
